  "pipeline_order": [
    {
      "stage": 1,
      "name": "input_sanitize_and_klippel_sliding_hpf",
      "notes": "65-180 Hz dynamic HPF (resting 82 Hz) driven by excursion observer + Volume (dB)"
    },
    {
      "stage": 2,
      "name": "hybrid_3band_psychoacoustic_bass_and_iso226",
      "notes": "Phase-clean missing-fundamental bass + Warmth Body + live Volume-linked ISO 226:2023 shelves"
    },
    {
      "stage": 3,
      "name": "bass_mono_anchor_lr4",
      "notes": "Exact 3-biquad M/S LR4 24 dB/oct (<180 Hz; 150 Hz in Reference) for coherent +5.6..+5.9 dB acoustic woofer coupling"
    },
    {
      "stage": 4,
      "name": "minphase_room_harman_fir_4096",
      "notes": "4096-tap @ 48 kHz per-mode speaker correction before multiband dynamics"
    },
    {
      "stage": 5,
      "name": "multiband_4band_lr4_dynamics",
      "notes": "Phase-aligned 4-band LR4 (160, 750, 3500 Hz) delivering primary loudness lift into -2.2 dBFS pre-spatial headroom bus"
    },
    {
      "stage": 6,
      "name": "post_dynamics_spatial_depth_and_shuffler_xtc",
      "notes": "6A: Colorless Schroeder AP + 4.4-13.7 ms comb-free ER; 6B: Optional 256-tap (0.917 ms) Cooper-Bauck M/S Shuffler XTC"
    },
    {
      "stage": 7,
      "name": "final_4x_true_peak_safety_limiter",
      "notes": "+0.8 dB gentle trim into -1.0 dBTP ceiling (10 ms lookahead, 80 ms release) -> hardware ALC1316 2-way crossover"
    }
  ],
