+engine_sink_for() { printf '%s' "${ENGINE_SINK_FOR[$1]:-$ENGINE_SINK}"; }
+engine_sink_present() { sink_present "${1:-$ENGINE_SINK}"; }
+is_engine_sink() {
+  case "$1" in
+    omarchy_speaker_engine|omarchy_speaker_studio|omarchy_speaker_studio_spatial|omarchy_speaker_studio_ref|omarchy_speaker_studio_voice|omarchy_speaker_spatial|omarchy_speaker_spatial_71)
+      return 0
+      ;;
+    *)
+      return 1
+      ;;
+  esac
+}
+is_speaker_or_engine_sink() {
+  [[ "$1" == *HiFi__Speaker__sink ]] || is_engine_sink "$1"
+}
