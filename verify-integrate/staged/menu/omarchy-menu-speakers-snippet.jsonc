{
  // Dell XPS 17 9720 Studio Audio Engineering Stack — Setup › Speakers rows
  // Merge into ~/.config/omarchy/extensions/omarchy-menu.jsonc (see omarchy-menu.jsonc.diff).
  // Descriptions match ~/.local/bin/speaker-profile word-for-word; ticks follow `speaker-profile current`.
  "setup.speakers": {"icon":"󰓃","label":"Speakers","title":"Laptop Speakers","aliases":["speakers","studio","spatial"],"description":"How the built-in speakers sound (Studio, 3D Spatial & Warm profiles)","when":"command -v speaker-profile >/dev/null || command -v omarchy-audio-spatial >/dev/null"},
  "setup.speakers.studio-deep": {"icon":"󰝚","label":"Studio Deep","description":"Deep, warm flagship studio sound with full physical bass","when":"[[ -f ~/.config/pipewire/omarchy-speaker-engine.conf.d/92-xps17-studio.conf && -f ~/.local/share/xps17-studio-audio/lib/libxps17_studio_dsp.so ]]","checked":"[[ \"$(speaker-profile current)\" == \"studio-deep\" ]]","action":"OMARCHY_NOTIFY=1 speaker-profile studio-deep"},
  "setup.speakers.studio-spatial": {"icon":"󰕾","label":"Studio Spatial","description":"Wide 3D cinema soundstage with deep, anchored bass","when":"[[ -f ~/.config/pipewire/omarchy-speaker-engine.conf.d/92-xps17-studio.conf && -f ~/.local/share/xps17-studio-audio/lib/libxps17_studio_dsp.so ]]","checked":"[[ \"$(speaker-profile current)\" == \"studio-spatial\" ]]","action":"OMARCHY_NOTIFY=1 speaker-profile studio-spatial"},
  "setup.speakers.studio-ref": {"icon":"󰗑","label":"Studio Reference","description":"Balanced studio reference tuning with tight, accurate bass","when":"[[ -f ~/.config/pipewire/omarchy-speaker-engine.conf.d/92-xps17-studio.conf && -f ~/.local/share/xps17-studio-audio/lib/libxps17_studio_dsp.so ]]","checked":"[[ \"$(speaker-profile current)\" == \"studio-ref\" ]]","action":"OMARCHY_NOTIFY=1 speaker-profile studio-ref"},
  "setup.speakers.studio-voice": {"icon":"󰗋","label":"Studio Voice","description":"Clear, intimate voices for calls, podcasts and videos","when":"[[ -f ~/.config/pipewire/omarchy-speaker-engine.conf.d/92-xps17-studio.conf && -f ~/.local/share/xps17-studio-audio/lib/libxps17_studio_dsp.so ]]","checked":"[[ \"$(speaker-profile current)\" == \"studio-voice\" ]]","action":"OMARCHY_NOTIFY=1 speaker-profile studio-voice"}
}
